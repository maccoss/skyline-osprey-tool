<Window x:Class="OspreyTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Osprey Tool" Height="760" Width="1080">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Osprey Tool" FontSize="22" FontWeight="Bold" Foreground="#1a3c6e" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,10">
            <Ellipse x:Name="ConnDot" Width="12" Height="12" Fill="#999" VerticalAlignment="Center"
                     ToolTip="Green = connected to a running Skyline document; gray = not connected (launch from Skyline)." />
            <TextBlock x:Name="ConnText" Margin="6,0,16,0" VerticalAlignment="Center" FontWeight="SemiBold"
                       Foreground="#555" Text="Not connected" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#777" TextWrapping="Wrap"
                       Text="Launch this tool from Skyline (Tools menu) to run against the active document." />
        </StackPanel>

        <!-- The only input: which of the document's spectral libraries to score against. Everything else
             (chromatograms, RT, library intensities, boundary write-back) is read from the document. -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Spectral library:" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" x:Name="LibraryCombo" VerticalAlignment="Center"
                      ToolTip="The document's spectral library - source of the fragment intensities for the median_polish_cosine scoring term." />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#888" TextWrapping="Wrap"
                       Text="Chromatograms, retention times, and library intensities are read from the document automatically." />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,8">
            <Button x:Name="RunButton" Content="Run" Padding="24,5" FontWeight="Bold" Click="OnRun" />
            <Button Content="Show command line" Padding="14,5" Margin="10,0,0,0" Click="OnShowCommandLine"
                    ToolTip="The equivalent 'ospreytool reconcile ...' command for the current settings (for the CLI on exported files)." />
        </StackPanel>

        <TabControl Grid.Row="4" x:Name="MainTabs">

            <!-- ============ Settings ============ -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="Scoring" FontWeight="Bold" Foreground="#1a3c6e" Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Peak detection:" Width="200" VerticalAlignment="Center" />
                            <ComboBox x:Name="DetectorCombo" Width="330"
                                      ToolTip="The algorithm that proposes candidate peaks. Osprey's CWT is the default; other algorithms can be plugged in (they implement IPeakDetector and need no Osprey dependency). Scoring, FDR and reconciliation are unchanged by this choice." />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Primary scoring:" Width="200" VerticalAlignment="Center" />
                            <ComboBox x:Name="ScoringCombo" Width="330"
                                      ToolTip="How the best peak is chosen. 'Osprey learned pick' is Osprey's own default: a frozen linear weighting of four standardized terms (coelution, ln intensity, RT penalty, median_polish_cosine), with weights that ship with Osprey - nothing is trained here. The two legacy options are the older multiplicative rank: coelution x exp(-dt^2/2sigma^2) x ln(1+intensity), optionally multiplied by the library spectral match. Only the legacy options are affected by the intensity exponent below.">
                                <ComboBoxItem IsSelected="True">Osprey learned pick (frozen LDA weights)</ComboBoxItem>
                                <ComboBoxItem>Legacy product rank</ComboBoxItem>
                                <ComboBoxItem>Legacy product rank + median_polish_cosine</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="RT sigma (min):" Width="200" VerticalAlignment="Center" />
                            <TextBox x:Name="RtSigmaBox" Width="70" Text="0.3"
                                     ToolTip="Width of the Gaussian RT prior in the pick score. Smaller trusts the predicted RT more; wider lets co-elution / spectral match choose within the scheduling window." />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Intensity exponent (w):" Width="200" VerticalAlignment="Center" />
                            <TextBox x:Name="IntensityExpBox" Width="70" Text="0"
                                     ToolTip="Exponent w on the intensity tiebreaker ln(1+I)^w in the pick score. 1 = Osprey-exact, but the other terms are bounded on [0,1] while this one is not, so a much more intense interference can outvote co-elution, spectral match and RT combined. 0 = off (rank on evidence only)." />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Hard RT gate (min):" Width="200" VerticalAlignment="Center" />
                            <TextBox x:Name="RtTolBox" Width="70" Text="0"
                                     ToolTip="Hard +/- RT limit around the expected RT. 0 = off: for scheduled PRM the extracted XIC IS the scheduling window, so the window is the only hard limit (recommended)." />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <CheckBox x:Name="AllTargetsCheck" Content="Reconcile all targets (targeted assay)" IsChecked="True" VerticalAlignment="Center"
                                      ToolTip="Reconcile every target precursor, not only FDR-confident ones. Recommended for a targeted PRM assay where every peptide is a known target." />
                        </StackPanel>

                        <TextBlock Text="Reconciliation" FontWeight="Bold" Foreground="#1a3c6e" Margin="0,12,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <CheckBox x:Name="ChargeConsensusCheck" Content="Intra-run charge-state consensus" IsChecked="True" VerticalAlignment="Center"
                                      ToolTip="Snap a peptide's minority charge states onto the leader charge's peak within each run." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <CheckBox x:Name="ReconcileCheck" Content="Inter-run consensus + reconciliation" IsChecked="True" VerticalAlignment="Center"
                                      ToolTip="Compute a cross-run consensus RT and Keep / snap-to-CWT / MBR-force-integrate each detection so replicates agree." />
                        </StackPanel>

                        <TextBlock Text="Display" FontWeight="Bold" Foreground="#1a3c6e" Margin="0,12,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Chromatogram colors:" Width="200" VerticalAlignment="Center" />
                            <ComboBox x:Name="ColorSchemeCombo" Width="330" SelectionChanged="OnColorSchemeChanged"
                                      ToolTip="Colour the XIC plot with one of Skyline's colour schemes (Tools &gt; Options &gt; Display), so it matches the chromatogram graph next to it. Skyline does not expose WHICH scheme is active, so pick the one you use." />
                        </StackPanel>

                        <TextBlock Text="FDR" FontWeight="Bold" Foreground="#1a3c6e" Margin="0,12,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <CheckBox x:Name="FdrCheck" Content="Percolator FDR (needs a decoy pairing manifest)" VerticalAlignment="Center" IsEnabled="False"
                                      ToolTip="Genuine-decoy Percolator FDR. Requires decoy precursors + a pairing manifest in the document - not yet wired into the connected workflow." />
                            <TextBlock Text="  q &#8804;" VerticalAlignment="Center" Margin="16,0,4,0" />
                            <TextBox x:Name="QBox" Width="60" Text="0.01" IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Candidate Peaks ============ -->
            <TabItem Header="Candidate Peaks">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <CheckBox x:Name="FollowSelectionCheck" Content="Follow Skyline selection" IsChecked="True"
                                  VerticalAlignment="Center" Checked="OnFollowChanged" Unchecked="OnFollowChanged"
                                  ToolTip="Click a peptide in Skyline's Targets tree (and select a replicate) and this panel updates itself. Uncheck to type a peptide by hand." />
                        <TextBlock Text="Peptide:" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <TextBox x:Name="ExplainPeptideBox" Width="220" Margin="8,0" IsEnabled="False" />
                        <TextBlock Text="Replicate:" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBox x:Name="ExplainReplicateBox" Width="180" Margin="8,0" IsEnabled="False"
                                 ToolTip="Substring of the replicate/file name; blank = all replicates." />
                        <Button x:Name="ExplainButton" Content="Explain" Padding="16,3" Margin="8,0,0,0"
                                Click="OnExplain" IsEnabled="False" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" x:Name="ExplainHeader" Margin="0,0,0,6" Foreground="#333" FontFamily="Consolas" />
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="5*" MinHeight="120" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6*" MinHeight="140" />
                        </Grid.RowDefinitions>
                        <DataGrid Grid.Row="0" x:Name="CandidatesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserSortColumns="True" FontFamily="Consolas" HeadersVisibility="Column"
                                  SelectionMode="Single" SelectionChanged="OnCandidateSelected">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <!-- The window reconciliation forced (not a CWT peak at all): call it out. -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source}" Value="consensus">
                                            <Setter Property="Background" Value="#fff3d6" />
                                            <Setter Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="replicate" Binding="{Binding File}" Width="150" />
                                <DataGridTextColumn Header="from" Binding="{Binding Source}" Width="80" />
                                <DataGridTextColumn Header="apex" Binding="{Binding ApexRt, StringFormat=F2}" Width="55" />
                                <DataGridTextColumn Header="start" Binding="{Binding StartRt, StringFormat=F2}" Width="55" />
                                <DataGridTextColumn Header="end" Binding="{Binding EndRt, StringFormat=F2}" Width="55" />
                                <DataGridTextColumn Header="coel" Binding="{Binding Coelution, StringFormat=F3}" Width="60" />
                                <DataGridTextColumn Header="libcos" Binding="{Binding LibCosine, StringFormat=F3}" Width="60" />
                                <DataGridTextColumn Header="dRT" Binding="{Binding RtResidual, StringFormat=F2}" Width="55" />
                                <DataGridTextColumn Header="rtPen" Binding="{Binding RtPenalty, StringFormat=F3}" Width="60" />
                                <DataGridTextColumn Header="lnI" Binding="{Binding IntensityWeight, StringFormat=F2}" Width="55" />
                                <DataGridTextColumn Header="RANK" Binding="{Binding Rank, StringFormat=F3}" Width="70" />
                                <DataGridTextColumn Header="pick (signal proc.)" Binding="{Binding Pick}" Width="120" />
                                <DataGridTextColumn Header="APPLIED (in document)" Binding="{Binding Applied}" Width="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#ddd" />
                        <sp:WpfPlot Grid.Row="2" x:Name="XicPlot" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============ Log ============ -->
            <TabItem Header="Log">
                <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" Background="#1e1e1e" Foreground="#dcdcdc" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
