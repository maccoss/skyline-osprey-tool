<Project>

  <PropertyGroup>
    <!-- Lets the net8.0-windows / WPF projects cross-compile on Linux/macOS/CI.
         No effect on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- Single source of truth for the assembly version. The Skyline tool manifest version lives
         separately in src/OspreyTool.App/tool-inf/info.properties and must be kept in lockstep at
         release time; .github/workflows/release.yml verifies both against the tag before publishing.
         Scheme: CalVer YY.feature.patch (see release-notes/README.md). -->
    <Version>26.2.0</Version>

    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Do NOT set InvariantGlobalization=true: WPF text layout throws
         CultureNotFoundException under it. Cross-machine numeric reproducibility is
         instead guaranteed by using CultureInfo.InvariantCulture explicitly in every
         data-parse / data-output path (the chromatogram TSV is exported invariant). -->
  </PropertyGroup>

</Project>
